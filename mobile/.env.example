EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public runtime token (starts with pk.) — safe to ship in the app bundle,
# used by Mapbox.setAccessToken() at runtime. From Mapbox account > Tokens.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Secret token (starts with sk.) — build-time only, read directly by
# Mapbox's native build scripts (Gradle/CocoaPods), not by app.config.js or
# any app JS. Needs the "Downloads:Read" scope. For `eas build`, set this
# as an EAS secret instead — it won't see your local .env. See README
# "Map setup (Mapbox)".
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your-mapbox-downloads-token
